# Spotify Developer Credentials
# 1. Go to https://developer.spotify.com/dashboard and log in
# 2. Click "Create App" (e.g. name: SpotDivoom)
# 3. Add Redirect URI: http://127.0.0.1:8888/callback
# 4. Copy Client ID and Client Secret into this file:
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Pixoo 64 Configuration
# Leave blank to auto-discover your Pixoo 64 on your local Wi-Fi network,
# or set it manually if you have a static IP assigned (e.g., 192.168.1.100)
PIXOO_IP=

# Polling interval in seconds (default: 3.0)
POLL_INTERVAL=3.0

# Behavior when music is paused:
# 'keep'  = keep displaying current track cover art
# 'idle'  = switch to idle mode (liked tracks + clock + weather)
# 'dim'   = dim current cover art
# 'clear' = clear display
ON_PAUSE=idle

# Idle Display Settings
# 'liked_tracks' (cycles covers of songs you like with time & weather HUD)
# 'spotify_logo' (the SpotDivoom logo; the name is kept for older .env files)
IDLE_MODE=liked_tracks

# Seconds between cycling liked track covers when idle (e.g. 30.0 or 60.0)
IDLE_CYCLE_INTERVAL=30.0

# Clock Format: 'false' for 12-hour (e.g., 9:37 PM), 'true' for 24-hour (e.g., 21:37)
USE_24H_TIME=false

# Where the time & weather bar sits: 'bottom' or 'top'
HUD_POSITION=bottom

# Color the temperature and progress line from the album art (true/false)
HUD_ACCENT=true
# Thin song-progress line along the bar while a track plays (true/false)
SHOW_PROGRESS=true
# Scroll the song title and artist across the screen (true/false)
SHOW_TITLE=false

# Idle screens to rotate through: 'cover', 'forecast', or 'cover,forecast'
IDLE_SCREENS=cover
# 'fade' for a short cross-fade between idle covers, 'none' for instant
IDLE_TRANSITION=none
# How many of your most recent Liked Songs the idle screen picks from
LIKED_TRACKS_LIMIT=500

# Night mode: 'off', 'dim' (lower brightness), 'clock' (dim clock on black) or 'screen_off'
NIGHT_MODE=off
NIGHT_START=23:00
NIGHT_END=07:00
# Brightness (%) used when NIGHT_MODE=dim
NIGHT_BRIGHTNESS=10

# Weather Settings (Uses Open-Meteo API - no API key required!)
# 'F' for Fahrenheit, 'C' for Celsius
WEATHER_UNIT=F

# Optional manual location override (leave blank to auto-detect via IP)
WEATHER_CITY=
WEATHER_LAT=
WEATHER_LON=

# Image enhancement for LED pixels (1.0 = standard, 1.15 = punchier contrast/color)
ENHANCE_CONTRAST=1.0
ENHANCE_COLOR=1.0
